    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-wrap-balancer": "^1.1.1",
