rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'mleongholami08@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }
    
    match /admins/{email} {
      allow read: if isAdmin() || request.auth.token.email == email;
      allow write: if isAdmin();
    }
    
    match /hero_gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /coverflow/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{docId} {
      allow read, write: if true;
    }
  }
}
