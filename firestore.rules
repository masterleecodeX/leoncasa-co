rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'kannyio08@gmail.com' || request.auth.token.email == 'mleongholami08@gmail.com');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['headline', 'excerpt', 'images', 'layout', 'publishedAt']) &&
             data.headline is string && data.headline.size() > 0 && data.headline.size() <= 200 &&
             data.excerpt is string && data.excerpt.size() > 0 && data.excerpt.size() <= 1000 &&
             data.images is list && data.images.size() > 0 && data.images.size() <= 10 &&
             data.layout is string && (data.layout == 'vertical' || data.layout == 'horizontal') &&
             data.publishedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPost(incoming());
      allow update: if isAdmin() && isValidPost(incoming());
      allow delete: if isAdmin();
    }
  }
}
