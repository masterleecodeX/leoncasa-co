rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['headline', 'excerpt', 'images', 'layout', 'publishedAt']) &&
             data.headline is string &&
             data.excerpt is string &&
             data.images is list &&
             data.layout is string &&
             data.publishedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPost(incoming());
      allow update: if isAdmin() && isValidPost(incoming());
      allow delete: if isAdmin();
    }
  }
}
